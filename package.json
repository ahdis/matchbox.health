{
  "name": "matchbox.health",
  "private": true,
  "description": "Static site for www.matchbox.health",
  "license": "Apache-2.0",
  "devDependencies": {
    "playwright": "^1.62.1"
  },
  "scripts": {
    "setup": "python3 -m venv .venv && .venv/bin/pip install -r requirements.txt && npm install --no-audit --no-fund && npx playwright install chromium",
    "build": ".venv/bin/python _build/build.py",
    "archive": "./_reference/archive.sh",
    "serve": "python3 -m http.server 8081 -d docs",
    "compare": "node _design/tools/compare.mjs",
    "check": "node _design/tools/linkcheck.mjs && node _design/tools/test-consent.mjs",
    "shots:blog": "node _design/tools/blog-shots.mjs"
  }
}
